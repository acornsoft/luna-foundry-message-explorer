<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Acornsoft.MessageExplorer.Credentials.Browser</RootNamespace>
    <AssemblyName>Acornsoft.MessageExplorer.Credentials.Browser</AssemblyName>
    <!-- The [JSImport] source generator emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <!-- Served next to the app by a browser (WebAssembly) app head, which loads it with JSHost.ImportAsync. -->
    <Content Include="wwwroot\lfme-vault.js" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="contentFiles\any\any\wwwroot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ME.Credentials\ME.Credentials.csproj" />
  </ItemGroup>
</Project>
