<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Acornsoft.MessageExplorer.Shell.MainWindow"
        Width="960"
        Height="640"
        Title="Acornsoft Message Explorer">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock x:Name="BannerText" FontSize="20" TextWrapping="Wrap" />
    <TextBlock x:Name="PolicyText" TextWrapping="Wrap" />
    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" />
    <StackPanel x:Name="AdminPanel" Spacing="8">
      <TextBlock Text="Admin" />
    </StackPanel>
  </StackPanel>
</Window>
