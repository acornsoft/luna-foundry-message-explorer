     License, v. 2.0. If a copy of the MPL was not distributed with this
     file, You can obtain one at https://mozilla.org/MPL/2.0/. -->
<!-- Icons: Font Awesome Free by Fonticons, Inc. (CC BY 4.0), through Projektanker.Icons.Avalonia (MIT). See THIRD-PARTY-NOTICES.md. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acornsoft.MessageExplorer.Shell.ViewModels"
             xmlns:qv="using:Acornsoft.MessageExplorer.Shell.QuickView"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="Acornsoft.MessageExplorer.Shell.Views.QuickView"
             x:DataType="vm:QuickViewViewModel">
  <UserControl.Styles>
    <Style Selector="Border.qv-root">
      <Setter Property="Background" Value="#121417" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.qv-root TextBlock">
      <Setter Property="Foreground" Value="#E6E8EB" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8A919C" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#2E3440" />
      <Setter Property="Background" Value="#1C2027" />
    </Style>
    <Style Selector="Border.pill.ok">
      <Setter Property="BorderBrush" Value="#2E7D32" />
      <Setter Property="Background" Value="#142A17" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Background" Value="#22324A" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.dead"><Setter Property="Background" Value="#4A1E22" /></Style>
    <Style Selector="Border.badge.dead TextBlock"><Setter Property="Foreground" Value="#FF8A8E" /></Style>
    <Style Selector="Border.badge.scheduled"><Setter Property="Background" Value="#2E2547" /></Style>
    <Style Selector="Border.badge.scheduled TextBlock"><Setter Property="Foreground" Value="#C7B5FF" /></Style>
    <Style Selector="Border.badge.transfer"><Setter Property="Background" Value="#3F3014" /></Style>
    <Style Selector="Border.badge.transfer TextBlock"><Setter Property="Foreground" Value="#F5C46B" /></Style>

    <Style Selector="i|Icon.active"><Setter Property="Foreground" Value="#4FA3FF" /></Style>
    <Style Selector="i|Icon.dead"><Setter Property="Foreground" Value="#FF5A5F" /></Style>
    <Style Selector="i|Icon.scheduled"><Setter Property="Foreground" Value="#A98BFF" /></Style>
    <Style Selector="i|Icon.transfer"><Setter Property="Foreground" Value="#F5A524" /></Style>
    <Style Selector="i|Icon"><Setter Property="FontSize" Value="14" /></Style>

    <Style Selector="Button.card">
      <Setter Property="Background" Value="#1A1D22" />
      <Setter Property="BorderBrush" Value="#2A2F37" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#20252C" />
      <Setter Property="BorderBrush" Value="#4FA3FF" />
    </Style>
    <Style Selector="Button.card.alarm">
      <Setter Property="BorderBrush" Value="#8A2D31" />
    </Style>
    <Style Selector="Button.card.open">
      <Setter Property="BorderBrush" Value="#F5A524" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#AEB4BE" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A2F37" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="#16191D" />
      <Setter Property="BorderBrush" Value="#2A2F37" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.accent"><Setter Property="Width" Value="3" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Margin" Value="0,6" /></Style>
    <Style Selector="Border.accent.active"><Setter Property="Background" Value="#4FA3FF" /></Style>
    <Style Selector="Border.accent.dead"><Setter Property="Background" Value="#FF5A5F" /></Style>
    <Style Selector="Border.accent.scheduled"><Setter Property="Background" Value="#A98BFF" /></Style>
    <Style Selector="Border.accent.transfer"><Setter Property="Background" Value="#F5A524" /></Style>
    <Style Selector="ListBox.rows">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B2014" />
    </Style>
    <Style Selector="TextBlock.reason">
      <Setter Property="Foreground" Value="#FF7A7E" />
    </Style>
    <Style Selector="TreeView.entities TreeViewItem">
      <Setter Property="MinHeight" Value="26" />
    </Style>
  </UserControl.Styles>

  <ThemeVariantScope RequestedThemeVariant="Dark">
    <Border Classes="qv-root" x:Name="QuickRoot">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8" BorderBrush="#2A2F37" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
            <i:Icon Value="fa-solid fa-moon" Foreground="#F5A524" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Quick view" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Border Classes="pill">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <i:Icon Value="fa-solid fa-cloud" FontSize="11" />
                  <TextBlock x:Name="QuickNamespaceText" Text="{Binding NamespaceName}" FontSize="12" />
                </StackPanel>
              </Border>
              <Border Classes="pill ok">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <i:Icon Value="fa-solid fa-lock" FontSize="11" Foreground="#7BD88F" />
                  <TextBlock x:Name="QuickPeekText" Text="{Binding PeekText}" FontSize="12" Foreground="#9BE5A8" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBlock Text="Top N" Classes="dim" VerticalAlignment="Center" FontSize="12" />
              <NumericUpDown x:Name="QuickPageSizeBox" Value="{Binding PageSize}" Minimum="1" Maximum="100" Increment="5"
                             FormatString="0" Width="120" ToolTip.Tip="How many messages each section peeks per page (1 to 100)." />
            </StackPanel>
            <Button Grid.Column="5" x:Name="QuickRefreshButton" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Read counts again">
              <i:Icon Value="fa-solid fa-rotate-right" />
            </Button>
            <Border Grid.Column="6" Classes="pill" Margin="6,0,0,0" BorderBrush="#F5A524">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <i:Icon Value="fa-solid fa-bolt" FontSize="11" Foreground="#F5A524" />
                <TextBlock Text="{Binding PageSizeText}" FontSize="12" Foreground="#F5C46B" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Body: tree | sections | drawer -->
        <Grid Grid.Row="1" ColumnDefinitions="290,*,Auto">
          <Border Grid.Column="0" BorderBrush="#2A2F37" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
              <TextBox DockPanel.Dock="Top" x:Name="QuickFindBox" Text="{Binding Filter}" Watermark="Find entity…" Margin="0,0,0,8" />
              <TextBlock DockPanel.Dock="Top" x:Name="QuickNotConnectedText" Text="{Binding NotConnectedText}" IsVisible="{Binding IsNotConnected}" TextWrapping="Wrap" Classes="dim" />
              <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
              <TextBlock DockPanel.Dock="Top" x:Name="QuickErrorText" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="#FF7A7E" />
              <TreeView x:Name="QuickTree" Classes="entities" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:QuickTreeNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:QuickTreeNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <i:Icon Value="{Binding Icon}" FontSize="12" Margin="0,0,6,0" Foreground="#F5A524" IsVisible="{Binding !IsGroup}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Classes.dim="{Binding IsGroup}" FontSize="13" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <Border Classes="badge" IsVisible="{Binding HasPrimaryBadge}"><TextBlock Text="{Binding PrimaryBadge}" /></Border>
                        <Border Classes="badge dead" IsVisible="{Binding HasDeadLetterBadge}"><TextBlock Text="{Binding DeadLetterBadge}" /></Border>
                        <Border Classes="badge scheduled" IsVisible="{Binding HasScheduledBadge}"><TextBlock Text="{Binding ScheduledBadge}" /></Border>
                        <Border Classes="badge transfer" IsVisible="{Binding HasTransferBadge}"><TextBlock Text="{Binding TransferBadge}" /></Border>
                      </StackPanel>
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
          </Border>

          <Panel Grid.Column="1">
            <TextBlock x:Name="QuickNoEntityText" Text="{Binding NoEntityText}" IsVisible="{Binding !HasEntity}" Classes="dim" Margin="16" />
            <Panel IsVisible="{Binding HasEntity}">
            <DockPanel x:Name="QuickEntityPanel" DataContext="{Binding Entity}" x:DataType="vm:QuickEntityViewModel" Margin="14,12,14,0">
              <!-- Header -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <i:Icon Value="{Binding Icon}" FontSize="18" Foreground="#F5A524" />
                <TextBlock x:Name="QuickEntityTitle" Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Breadcrumb}" Classes="dim mono" VerticalAlignment="Center" />
                <Border Classes="pill" IsVisible="{Binding HasStatus}"><TextBlock Text="{Binding Status}" FontSize="11" /></Border>
              </StackPanel>

              <!-- Lane cards strip (counts are clickable: open and jump to the section) -->
              <ItemsControl DockPanel.Dock="Top" x:Name="QuickLaneCards" ItemsSource="{Binding Lanes}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickLaneViewModel">
                    <Button Classes="card" Classes.alarm="{Binding Alarm}" Classes.open="{Binding IsExpanded}" Command="{Binding JumpCommand}"
                            ToolTip.Tip="{Binding Path}">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <i:Icon Value="{Binding Icon}" FontSize="16" Margin="0,0,8,0"
                                  Classes.active="{Binding IsActiveLane}" Classes.dead="{Binding IsDeadLane}"
                                  Classes.scheduled="{Binding IsScheduledLane}" Classes.transfer="{Binding IsTransferLane}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Path}" Classes="dim mono" FontSize="10" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <i:Icon Grid.Column="2" Value="fa-solid fa-chevron-down" FontSize="10" Foreground="#8A919C" />
                        </Grid>
                        <TextBlock Text="{Binding CountText}" FontSize="28" FontWeight="Bold" Classes.reason="{Binding Alarm}" />
                        <TextBlock Text="{Binding CardFooter}" Classes="dim" FontSize="11" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Sections that cascade open as rows -->
              <ScrollViewer x:Name="QuickSectionsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="QuickSections" ItemsSource="{Binding Lanes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickLaneViewModel">
                      <Border Classes="section">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Classes="accent" Classes.active="{Binding IsActiveLane}" Classes.dead="{Binding IsDeadLane}"
                                  Classes.scheduled="{Binding IsScheduledLane}" Classes.transfer="{Binding IsTransferLane}" />
                          <StackPanel>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="8,6">
                              <Button Classes="icon" Command="{Binding ToggleCommand}" IsVisible="{Binding IsPeekable}" ToolTip.Tip="Open or close">
                                <Panel>
                                  <i:Icon Value="fa-solid fa-chevron-right" FontSize="11" IsVisible="{Binding !IsExpanded}" />
                                  <i:Icon Value="fa-solid fa-chevron-down" FontSize="11" IsVisible="{Binding IsExpanded}" />
                                </Panel>
                              </Button>
                              <i:Icon Grid.Column="1" Value="{Binding Icon}" Margin="4,0,8,0"
                                      Classes.active="{Binding IsActiveLane}" Classes.dead="{Binding IsDeadLane}"
                                      Classes.scheduled="{Binding IsScheduledLane}" Classes.transfer="{Binding IsTransferLane}" />
                              <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <Border Grid.Column="3" Classes="badge" Classes.dead="{Binding Alarm}" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountText}" />
                              </Border>
                              <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Path}" Classes="dim mono" TextTrimming="CharacterEllipsis" IsVisible="{Binding !HasNote}" />
                                <TextBlock Text="{Binding Note}" Classes="dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                              </StackPanel>
                              <TextBlock Grid.Column="5" Text="{Binding Status}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                              <Button Grid.Column="6" Classes="icon" Command="{Binding RefreshCommand}" IsVisible="{Binding IsPeekable}" ToolTip.Tip="Peek again from the first message">
                                <i:Icon Value="fa-solid fa-rotate-right" FontSize="12" />
                              </Button>
                              <Button Grid.Column="7" Classes="icon" Command="{Binding JumpCommand}" IsVisible="{Binding IsPeekable}" ToolTip.Tip="Open this section">
                                <i:Icon Value="fa-solid fa-up-right-and-down-left-from-center" FontSize="12" />
                              </Button>
                            </Grid>
                            <StackPanel IsVisible="{Binding IsExpanded}">
                              <Grid ColumnDefinitions="56,124,70,3*,62,2*,58" Margin="18,2,10,2">
                                <TextBlock Grid.Column="0" Text="SEQ #" Classes="dim" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="MESSAGE ID" Classes="dim" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="UTC" Classes="dim" FontSize="11" />
                                <TextBlock Grid.Column="3" Text="SUBJECT · BODY (MASKED)" Classes="dim" FontSize="11" />
                                <TextBlock Grid.Column="4" Text="SIZE" Classes="dim" FontSize="11" />
                                <TextBlock Grid.Column="5" Text="REASON" Classes="dim" FontSize="11" />
                              </Grid>
                              <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MaxHeight="340"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:QuickMessageRow">
                                    <Grid ColumnDefinitions="56,124,70,3*,62,2*,58">
                                      <TextBlock Grid.Column="0" Text="{Binding Message.SequenceText}" Classes="mono" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="1" Text="{Binding Message.MessageId}" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Text="{Binding Message.EnqueuedText}" Classes="mono dim" VerticalAlignment="Center" />
                                      <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Message.Subject}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Message.BodyPreview}" Classes="mono dim" FontSize="11" TextTrimming="CharacterEllipsis" />
                                      </StackPanel>
                                      <TextBlock Grid.Column="4" Text="{Binding Message.SizeText}" Classes="dim" VerticalAlignment="Center" />
                                      <Grid Grid.Column="5" ColumnDefinitions="Auto,*" VerticalAlignment="Center" ClipToBounds="True" Margin="0,0,6,0">
                                        <i:Icon Value="fa-solid fa-triangle-exclamation" FontSize="11" Foreground="#FF5A5F" Margin="0,0,6,0" IsVisible="{Binding Message.HasReason}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message.Reason}" Classes.reason="{Binding Message.HasReason}" Classes.dim="{Binding !Message.HasReason}" TextTrimming="CharacterEllipsis" />
                                      </Grid>
                                      <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Classes="icon" Command="{Binding OpenCommand}" ToolTip.Tip="Open in the detail drawer"><i:Icon Value="fa-solid fa-eye" FontSize="12" /></Button>
                                        <Button Classes="icon" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the redacted text"><i:Icon Value="fa-regular fa-copy" FontSize="12" /></Button>
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                              <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF7A7E" Margin="18,4" TextWrapping="Wrap" />
                              <Grid ColumnDefinitions="*,Auto" Margin="18,4,10,8">
                                <TextBlock Text="Virtualized list · peek only, no locks" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <i:Icon Value="fa-solid fa-angles-down" FontSize="11" Foreground="#F5A524" />
                                    <TextBlock Text="{Binding LoadMoreText}" Foreground="#F5C46B" FontSize="12" />
                                  </StackPanel>
                                </Button>
                              </Grid>
                            </StackPanel>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            </Panel>
          </Panel>

          <!-- Detail drawer -->
          <Border Grid.Column="2" x:Name="QuickDrawer" Width="360" Background="#15181C" BorderBrush="#2A2F37" BorderThickness="1,0,0,0"
                  IsVisible="{Binding Entity.HasSelection, FallbackValue=False}">
            <ScrollViewer DataContext="{Binding Entity.Selected}" x:DataType="vm:QuickMessageRow">
              <StackPanel Margin="14,12" Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <i:Icon Value="fa-solid fa-envelope-open-text" Foreground="#F5A524" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="QuickDrawerTitle" Text="{Binding Message.SequenceText, StringFormat='#{0}'}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Message.MessageId}" Classes="mono dim" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the redacted text"><i:Icon Value="fa-regular fa-copy" FontSize="12" /></Button>
                  <Button Grid.Column="3" Classes="icon" x:Name="QuickDrawerClose" Click="OnCloseDrawer" ToolTip.Tip="Close"><i:Icon Value="fa-solid fa-xmark" FontSize="13" /></Button>
                </Grid>
                <Border Background="#2A1416" BorderBrush="#8A2D31" BorderThickness="1" CornerRadius="6" Padding="10,8" IsVisible="{Binding Message.HasReason}">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <i:Icon Value="fa-solid fa-skull-crossbones" Foreground="#FF5A5F" FontSize="12" />
                      <TextBlock Text="{Binding Message.Reason}" Classes="reason" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message.Description}" TextWrapping="Wrap" FontSize="12" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <i:Icon Value="fa-solid fa-gear" FontSize="11" Foreground="#F5A524" />
                  <TextBlock Text="SYSTEM PROPERTIES" FontSize="11" FontWeight="SemiBold" Foreground="#F5A524" />
                </StackPanel>
                <ItemsControl x:Name="QuickSystemProperties" ItemsSource="{Binding Message.SystemProperties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="qv:QuickField">
                      <Grid ColumnDefinitions="140,*" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Classes="dim" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Message.HasApplicationProperties}">
                  <i:Icon Value="fa-solid fa-tags" FontSize="11" Foreground="#F5A524" />
                  <TextBlock Text="APPLICATION PROPERTIES · MASKED" FontSize="11" FontWeight="SemiBold" Foreground="#F5A524" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Message.ApplicationProperties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="qv:QuickField">
                      <Grid ColumnDefinitions="140,*" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Classes="dim" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <i:Icon Value="fa-solid fa-file-code" FontSize="11" Foreground="#F5A524" />
                  <TextBlock Text="BODY · MASKED" FontSize="11" FontWeight="SemiBold" Foreground="#F5A524" />
                </StackPanel>
                <Border Background="#0E1013" BorderBrush="#2A2F37" BorderThickness="1" CornerRadius="6" Padding="10">
                  <SelectableTextBlock x:Name="QuickBodyText" Text="{Binding Message.BodyText}" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Foreground="#E6E8EB" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="12,6" BorderBrush="#2A2F37" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-circle-info" FontSize="11" Foreground="#F5A524" />
            <TextBlock x:Name="QuickFooterText" Text="{Binding FooterText}" Classes="dim" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </ThemeVariantScope>
</UserControl>
