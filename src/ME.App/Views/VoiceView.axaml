<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Acornsoft.MessageExplorer.Shell.ViewModels"
             xmlns:voice="using:Acornsoft.MessageExplorer.Voice"
             x:Class="Acornsoft.MessageExplorer.Shell.Views.VoiceView"
             x:DataType="vm:VoiceViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Text="Grok Voice" FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="VoiceReadOnlyText" Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" Classes="state" />
    </StackPanel>

    <Border DockPanel.Dock="Top" BorderBrush="#40808080" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <TextBlock Text="Settings" FontWeight="SemiBold" />
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Voice" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="VoicePicker" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinWidth="320" IsEnabled="{Binding !IsRunning}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="voice:GrokVoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox x:Name="VoiceRedactBodies" Content="Redact message bodies (recommended)" IsChecked="{Binding RedactBodies}" IsEnabled="{Binding !IsRunning}" Margin="16,0,0,0" />
        </WrapPanel>
        <TextBlock Text="xAI's built-in voices only." Opacity="0.7" />
        <TextBlock x:Name="VoiceKeyStatus" Text="{Binding KeyStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button x:Name="VoiceStart" Content="Start session" Command="{Binding StartCommand}" />
      <Button x:Name="VoiceStop" Content="Stop" Command="{Binding StopCommand}" />
      <Button x:Name="VoiceTalk" Content="Hold to talk" IsEnabled="{Binding CanTalk}" MinWidth="140" Classes.talking="{Binding IsTalking}" />
      <TextBlock x:Name="VoiceStatus" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="VoiceAudioNote" Text="{Binding AudioNote}" IsVisible="{Binding AudioNote, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Top" x:Name="VoiceCredential" Text="{Binding Credential}" IsVisible="{Binding Credential, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" x:Name="VoiceAsk" Content="Ask" Command="{Binding AskCommand}" Margin="8,0,0,0" IsDefault="True" />
      <TextBox x:Name="VoiceAskText" Text="{Binding AskText}" Watermark="Or type a question, for example: which queues have dead letters?" IsEnabled="{Binding IsRunning}" />
    </DockPanel>

    <Grid ColumnDefinitions="2*,16,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Conversation" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ScrollViewer>
          <ItemsControl x:Name="VoiceTranscript" ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VoiceLine">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Width="48" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="700" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Read-only tools used" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="VoiceToolCalls" ItemsSource="{Binding ToolCalls}" />
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
