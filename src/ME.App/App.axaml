<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="Acornsoft.MessageExplorer.Shell.App"
             Name="Luna Foundry Message Explorer"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- Icon + label pairs, app-wide. Put the icon and its TextBlock in a panel with class "il": both are centered
         on the row, so the glyph's middle lines up with the text line's middle. No baseline nudges or top margins;
         HeadlessIconAlignmentTests holds every pair to within 1px. -->
    <Style Selector="i|Icon">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Panel).il > i|Icon">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Panel).il > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.deadletter">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.deadletter">
      <Setter Property="Background" Value="#33C62828" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.passed">
      <Setter Property="Foreground" Value="#2E7D32" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.late">
      <Setter Property="Foreground" Value="#B26A00" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.pending">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.state">
      <Setter Property="Margin" Value="0,16" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="Border.movebanner">
      <Setter Property="Background" Value="#FFF3CD" />
      <Setter Property="BorderBrush" Value="#B26A00" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.movebanner TextBlock">
      <Setter Property="Foreground" Value="#5C3B00" />
    </Style>
    <Style Selector="Border.droptarget">
      <Setter Property="Background" Value="#332E7D32" />
      <Setter Property="BorderBrush" Value="#2E7D32" />
    </Style>
  </Application.Styles>
</Application>
