<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />
  <!-- Sample plugins build to one fixed folder, so job files can name them without a configuration in the path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <OutputPath>$(MSBuildThisFileDirectory)../../artifacts/plugins/$(MSBuildProjectName)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The fault model (throttle, transient faults, retries, dead letters) is shared by the C# sample plugins. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
